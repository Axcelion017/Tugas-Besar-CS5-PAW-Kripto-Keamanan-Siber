# Konfigurasi Lingkungan (Environment Variables) Resilio-Health
# Salin berkas ini menjadi .env dan sesuaikan dengan kredensial PostgreSQL lokal Anda

# Database URL PostgreSQL (Port default: 5432, Database: resilio_health)
DATABASE_URL="postgresql://postgres:password_anda@localhost:5432/resilio_health?schema=public"

# Node Environment
NODE_ENV="development"
